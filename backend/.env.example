# For running the backend WITHOUT Docker. Copy to backend/.env
# Generate a key with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./cloudpulse.db
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
DEMO_BASE_URL=http://localhost:8000
CHECK_TICK_SECONDS=15
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_VIEWER_PASSWORD=change-me-viewer-password
